# ---------------------------------------------------------------------
# PRIME ESTATES — environment variables
# Copy to .env and fill in. NEVER commit .env. NEVER expose service keys.
#
# Every variable below is genuinely read by the code. Nothing here is
# decorative — if it is listed, something depends on it.
# ---------------------------------------------------------------------

# --- Server ----------------------------------------------------------
PORT=3000
NODE_ENV=development


# --- Admin login -----------------------------------------------------
# Used to create the FIRST admin user on first boot, and to reset that
# user's password on later boots if you change it here.
#
# In production BOTH are mandatory and ADMIN_PASSWORD must be >= 12
# characters — the server refuses to start otherwise. There is no
# fallback/default admin account.
#
# In local development you may leave these blank; the server then
# generates a random password and prints it once to the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# --- Database --------------------------------------------------------
# Local dev: leave DATABASE_URL empty to use the bundled embedded
# Postgres (PGlite) in ./data/pgdata — zero setup, no install needed.
#
# Production: REQUIRED. The server hard-fails at boot if this is unset
# when NODE_ENV=production, so a live deploy can never silently fall
# back to a throwaway embedded database.
#
# Supabase: use the CONNECTION POOLER string (port 6543), not 5432 —
# serverless functions open many short-lived connections.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=


# --- Supabase Storage (image hosting) --------------------------------
# Local dev: leave blank to store uploads on disk in ./public/uploads.
# Production: REQUIRED. Uploads must not go to a serverless filesystem
# (it is read-only and ephemeral), so the server refuses to start
# without these when NODE_ENV=production.
#
# SERVER-SIDE ONLY. These are read by server/storage.mjs and are never
# bundled into the browser. Do NOT add a VITE_ prefix to the service
# role key — that would publish a full-admin database key to every
# visitor. The frontend never talks to Supabase directly; it only ever
# calls this app's own /api routes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-images


# ---------------------------------------------------------------------
# Deliberately NOT used
# ---------------------------------------------------------------------
# SESSION_SECRET — not needed. Sessions are not signed cookies; they are
#   random 256-bit tokens stored in the admin_sessions table and matched
#   server-side, so there is no secret to leak or rotate.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY — not needed. Anything with
#   a VITE_ prefix is compiled into public JavaScript. This app keeps all
#   database access behind its own API, so the browser needs no keys.


# --- Optional: Supabase image transformations ------------------------
# Supabase can resize uploaded images on the fly, which lets property cards
# fetch a 400px file instead of the full-resolution upload. This is a PAID
# Supabase feature — on the free plan the endpoint errors and images break.
# Turn it on only if your plan includes it. Not a secret: it is a boolean.
VITE_SUPABASE_IMAGE_TRANSFORMS=false
